{
  "name": "flip-tiles-app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "serve": "npx --yes netlify-cli dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && vitest run && playwright test",
    "curate": "node scripts/curate-levels.mjs",
    "seed": "node scripts/seed-leaderboard.mjs",
    "icons": "node scripts/make-icons.mjs",
    "sync": "node scripts/sync-version.mjs && npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "android:live": "node scripts/android-live.mjs",
    "android:tunnel": "node scripts/android-live.mjs --tunnel",
    "ios": "npm run sync && cap open ios",
    "release-check": "node scripts/release-check.mjs",
    "release": "npm run release-check && npm run check && npm run sync"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@netlify/blobs": "^10.7.13",
    "@netlify/functions": "^6.1.1",
    "@playwright/test": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/lilita-one": "^5.3.0",
    "capacitor-plugin-cdv-purchase": "^13.20.0"
  }
}
